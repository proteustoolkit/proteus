# test/SWFlow/circular_damBreak.py (sw_model=0) as a spec: a circular dam break on a flat 20 m × 20 m bed with walls,
# solved by the convex-limited scheme of proteus_numerics.ymf (SW2DCV) on SWFlow's structured mesh (the deck's
# structured=True, nnx = nny = 50, i.e. 49 cells per side), for two seconds (5 outputs). test_dispatch_run.py runs it
# from the spec through ymf_run and from the deck through parun and compares the solutions bitwise.
extends: proteus_numerics.ymf

model:
  name: "Circular dam break, 20 m × 20 m (circular_damBreak)"
  physical_model: {provenance: human_specified}
  strong_form:
    domain: "Ω = [0, 20] × [0, 20],  t ∈ (0, 2]"
    boundary_regions:
      - {name: all, where: "∂Ω"}
    boundary_sets:
      - {region: all, set: wall}
    initial_conditions:
      - {field: h, type: function, formula: "1 + 0.8 heaviside(4 − (x − 10)² − (y − 10)²)", units: m}
      - {field: q, type: constant, value: 0.0}
    coefficients:
      g: {value: 9.81}
      n: {value: 0.0}
      θ: {value: 1.0}
      Z: {value: 0.0}
      α: {value: 0.0}
      β: {value: 0.0}

solution_paths:
  analytical: []
  discretizations:
    - name: convex_limited
      mesh: {cells: 49}
      step_control: {type: min_cfl, cfl: 0.25}
      discretization: {outputs: 5}
