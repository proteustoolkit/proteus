# ------------------------------------------- #
# The Python signatures below are the ones TimeIntegration.py calls, the
# contract of the C module these wrappers replaced in 2019 (#879): the sizes
# come from the array shapes, the limiter flag is the last argument and
# psiTCtteDT returns the new step. The 2019 wrappers asked the caller for the
# sizes instead, so every call in TimeIntegration.py raised TypeError.
def psiTCtteDT(double tau,
               double dtn,
               double dtnm1,
               np.ndarray yn,
               np.ndarray ypn,
               np.ndarray ypnm1):
    cdef double dtnp1 = 0.0
    cpsiTCtteDT(yn.size,
                tau,
                dtn,
                dtnm1,
                <double*> yn.data,
                <double*> ypn.data,
                <double*> ypnm1.data,
                &dtnp1)
    return dtnp1

def applyDGlimitingP1Lagrange1d(np.ndarray elementNodesArray,
                                np.ndarray elementNeighborsArray,
                                np.ndarray nodeArray,
                                np.ndarray elementBarycentersArray,
                                np.ndarray l2g,
                                np.ndarray tag,
                                np.ndarray Uin,
                                np.ndarray Uout,
                                int limiterFlag=1):
    capplyDGlimitingP1Lagrange1d(limiterFlag,
                                 elementNodesArray.shape[0],
                                 elementNodesArray.shape[1],
                                 elementNeighborsArray.shape[1],
                                 l2g.shape[1],
                                 <proteus_index_t*> elementNodesArray.data,
                                 <proteus_index_t*> elementNeighborsArray.data,
                                 <double*> nodeArray.data,
                                 <double*> elementBarycentersArray.data,
                                 <proteus_index_t*> l2g.data,
                                 <int*> tag.data,
                                 <double*> Uin.data,
                                 <double*> Uout.data)

